{
  "manifest_version": 3,
  "name": "SpideyContent AI — Google Flow & Shopee Connector",
  "version": "1.1.0",
  "description": "Bridges SpideyContent AI to your logged-in Google Flow account AND unwraps shortened Shopee/TikTok affiliate links (s.shopee.com.my) without API keys.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "clipboardWrite",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.shopee.com.my/*",
    "https://*.shopee.sg/*",
    "https://*.shopee.co.id/*",
    "https://*.shopee.ph/*",
    "https://*.shp.ee/*",
    "https://*.susercontent.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*",
    "https://*.pages.dev/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://*.pages.dev/*",
        "file:///*"
      ],
      "js": ["studio-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    }
  ]
}
